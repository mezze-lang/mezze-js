# JavaScript host-language access (GraalJS).
#
# `JsForeign` wraps a JS object (module, function, object literal, array, Map,
# primitive). All JS interop routes through this type — `perform GraalJs in do
# ...` gives `Js.import`, `Js.require`, and `Js.eval`, each yielding
# `Result JsForeign InteropError`.
#
# THIS PACKAGE WRITES NO NATIVES. Every operation delegates to the first-party
# `Polyglot` effect from `std::polyglot::core`, whose sole handler `Runtime` is
# the only thing that touches the runtime's native interop surface. Each verb
# buries its own `perform Runtime in Polyglot.<op> …`, so a user calls
# `jf.property{}` / `Js.require{}` with no enclosing perform and never sees a
# `Polyglot.*` op or the guest id `"js"` — that string is baked into this module
# exactly once per entry point.
#
# The verb set is the smallest that is still COMPLETE against the JS object model,
# named the JS way: `property`/`set_property`/`has` (obj.x / obj.x=v / `x in obj`),
# `index`/`set_index` (arr[i]), `key`/`set_key` (Map/dict), `entries`
# (Object.entries), `len` (.length/.size), `to_seq` (Array.from — drains any
# iterable), `call`/`method`/`new`, and `int`/`float`/`str`/`bool`/`is_null`/
# `type_name`. Mirrors std::polyglot::jvm's shape with JS vocabulary.
use std::polyglot::core::{ InteropError, Polyglot, Runtime, Foreign }

## Opaque handle to a JS object. Wraps the public `Foreign` handle (never the
## internal native primitive); the newtype gives Mezze-level type safety against
## mixing JS and non-JS Foreigns.
pub newtype JsForeign = Foreign

## JS host effect — the typed entry point. Three module-resolution paths: `eval`
## for arbitrary expressions, `require` for CommonJS modules (needs `[polyglot.js]`
## `node_modules` in the manifest), and `import` for ESM dynamic imports. The user
## performs only `GraalJs`; its handler buries `perform Runtime` internally.
effect Js where {
  import:  { module: Str } -> JsForeign <Js>,
  require: { module: Str } -> JsForeign <Js>,
  eval:    { source: Str } -> JsForeign <Js>
}

## Default JS host — routes all ops through the ambient Truffle Env's GraalJS
## interpreter. Zero-field: the polyglot Context is managed by the runtime from
## `Mezze.toml [polyglot.js]`; the handler carries no user configuration. The
## handler type is introduced by the impl itself — no separate `type` is needed.
impl Js for GraalJs where {
  ## Evaluate a JS expression. `"js"` is baked here (one of the entry points).
  ## `eval_raw` yields a bare ERROR-CARRYING foreign, and that is what this entry
  ## point hands back — the same shape `Jvm.class` has in the reference provider.
  ## The crossing happens once, at a VALUE-OUT verb (`.int{}`, `.str{}`), not here:
  ## that is what lets `Js.eval { … }.property { name = "x" }.int {}` read flat.
  eval    = { source } -> perform Runtime in
    Polyglot.eval_raw { lang = "js", source = source },
  ## CommonJS `require`, WITHOUT string interpolation: eval the constant `require`
  ## binding to get the loader callable, then `execute` it with the module name as
  ## a BOXED argument — no quote-breakout / injection surface. `execute` yields a
  ## bare foreign too, so both producer steps chain on the foreign and the error
  ## stays buried in it until a value-out verb asks.
  require = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_raw { lang = "js", source = "require" },
        args = [Polyglot.box_str { val = module, lang = "js" }],
      },
  ## ESM dynamic import, injection-free: eval the constant async arrow
  ## `(m) => import(m)` to get an importer, then `execute` it with the module name
  ## boxed. Returns whatever the guest yields for `import(m)` — resolution depends
  ## on the Context draining its microtask queue, the same assumption the prior
  ## interpolated implementation relied on.
  import  = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_raw { lang = "js", source = "(async (m) => await import(m))" },
        args = [Polyglot.box_str { val = module, lang = "js" }],
      },
}

## Sandboxed JS host — the SAME `Js` effect as `GraalJs`, but every op runs in an
## isolated INNER context with an explicit access policy. `perform GraalJsWith { … }
## in do …` IS the isolation boundary: `initialize_scope` opens the inner context on
## entry (binding its handle to `scope`) and `finalize_scope` tears it down on exit,
## so globals don't leak between scopes and access is restricted BELOW the permissive
## parent. A `Js.eval` result here is a live foreign over that inner context —
## chainable with the usual `.property{}` / `.int{}` verbs while the scope is open,
## and degrading to an error once it closes. User code still writes only `Js.*`;
## `Polyglot`/`Runtime`/`"js"` stay buried exactly as in `GraalJs`.
##
## The ONE field is `config` — the full `Context.Builder` policy as a structural
## record (NOT a nominal type; mezze is structural). It is required (mezze has no
## field defaults), so spread the provider default `js_defaults` and override only
## the knobs you want:
##   perform GraalJsWith { config = { ...js_defaults, allow_io = False } } in do …
impl Js for GraalJsWith { config: { allow_io: Bool, allow_native: Bool, allow_create_thread: Bool, allow_create_process: Bool, allow_host_class_loading: Bool, allow_host_lookup: Bool, allow_polyglot_access: Bool } } where {
  ## Open the isolated inner context from `config`; its handle binds to `scope`.
  initialize_scope = {} -> perform Runtime in Polyglot.open_context { lang = "js", config = config },
  ## Tear the inner context down at scope exit; a held foreign errors after this.
  finalize_scope = {} -> do
    perform Runtime in Polyglot.close_context { ctx = scope }
    {},
  ## Evaluate IN the inner context — `eval_in` yields a live foreign over the result,
  ## tagged with the context so the object API keeps working.
  eval    = { source } -> perform Runtime in
    Polyglot.eval_in { ctx = scope, source = source },
  require = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_in { ctx = scope, source = "require" },
        args = [Polyglot.box_str { val = module, lang = "js" }],
      },
  import  = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_in { ctx = scope, source = "(async (m) => await import(m))" },
        args = [Polyglot.box_str { val = module, lang = "js" }],
      },
}

## Default `Context.Builder` policy for `GraalJsWith` — PERMISSIVE (everything
## allowed, matching the ambient `GraalJs`). Sandboxing is OPT-IN: spread this and
## deny the knobs you want, e.g. `GraalJsWith { config = { ...js_defaults, allow_native = False } }`.
## It is a plain structural record VALUE — override any subset, add nothing.
##
## JS-SPECIFIC: `allow_native`, `allow_create_thread`, `allow_create_process`,
## `allow_host_class_loading`, `allow_host_lookup` all restrict cleanly — denying
## them still runs js. Two knobs must stay True: `allow_polyglot_access` (evaluating
## INTO the inner context is itself a polyglot op — true for every language) and
## `allow_io` (GraalJS needs it to initialize its engine). Keeping `allow_io` on is
## SAFE for a sandbox, not a hole: bare ECMAScript has NO filesystem API — `require`
## resolves no `fs` module, so a script cannot read a file. The only way a js script
## reaches the host (or, through it, the disk) is `Java`/host interop, which is gated
## by `allow_host_lookup` + `allow_host_class_loading` — set those False and `Java`
## is `undefined`. (File IO becomes reachable only if you OPT IN to Node via the
## manifest's `node_modules`; then you are deliberately granting it.) So a restricted
## js sandbox needs no virtual-filesystem machinery — the capability booleans cover it.
pub let js_defaults: { allow_io: Bool, allow_native: Bool, allow_create_thread: Bool, allow_create_process: Bool, allow_host_class_loading: Bool, allow_host_lookup: Bool, allow_polyglot_access: Bool } =
  { allow_io = True, allow_native = True, allow_create_thread = True, allow_create_process = True, allow_host_class_loading = True, allow_host_lookup = True, allow_polyglot_access = True }

## The complete JS verb set on a JsForeign. Every verb buries its own
## `perform Runtime`, so chains run with no enclosing perform.
##
## PRODUCER verbs yield a bare ERROR-CARRYING JsForeign, so they chain directly:
## `Js.eval { … }.property { name = "x" }.int {}`. CROSSING verbs are where the
## error surfaces, as `Result X InteropError`. There is NO `impl Result JsForeign`
## mirror: an inherent method belongs to the module owning the receiver, and
## `Result` is owned by `std::result` (V0406). The reference provider
## (`std::polyglot::jvm`) has always had this shape.
impl JsForeign where {
  ## ---- properties: obj.x / obj.x = v / x in obj ----

  ## Read a named property — JS `obj.name`.
  property     = { it, name } ->
    perform Runtime in Polyglot.read_member { on = it, name = name },
  ## Assign a named property — JS `obj.name = val`.
  set_property = { it, name, val } ->
    perform Runtime in Polyglot.write_member { on = it, name = name, val = val },
  ## True iff the property is readable — JS `name in obj`.
  has          = { it, name } ->
    perform Runtime in Polyglot.has_member { on = it, name = name },

  ## ---- call / method / construct ----

  ## Call a callable — JS `f(...args)`.
  call   = { it, args } ->
    perform Runtime in Polyglot.execute { on = it, args = args },
  ## Call a method by name — JS `obj.name(...args)`.
  method = { it, name, args } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = name, args = args },
  ## Instantiate a constructor — JS `new Ctor(...args)`.
  new    = { it, args } ->
    perform Runtime in Polyglot.instantiate { on = it, args = args },

  ## ---- array elements: arr[i] ----

  ## Read an indexed element — JS `arr[i]`.
  index     = { it, i } ->
    perform Runtime in Polyglot.read_array { on = it, index = i },
  ## Assign an indexed element — JS `arr[i] = val`.
  set_index = { it, i, val } ->
    perform Runtime in Polyglot.write_array { on = it, index = i, val = val },

  ## ---- Map / dict entries ----

  ## Read a mapping entry by key — JS `map.get(k)`. `key` may be a Foreign or a
  ## bare Mezze value.
  key     = { it, of } ->
    perform Runtime in Polyglot.read_hash { on = it, key = of },
  ## Write a mapping entry — JS `map.set(k, v)`.
  set_key = { it, of, val } ->
    perform Runtime in Polyglot.write_hash { on = it, key = of, val = val },
  ## Every mapping entry as a seq of two-element `[key, value]` Foreigns — the
  ## shape a codec's `decode_mapping` walks (JS `Object.entries` / `Map.entries`).
  entries = { it } ->
    perform Runtime in Polyglot.hash_entries { on = it },

  ## ---- length / iteration ----

  ## Length — array elements or Map entries (JS `.length` / `.size`).
  len    = { it } ->
    perform Runtime in Polyglot.size { on = it },
  ## Drain any iterable — an array, generator, Set, or `[Symbol.iterator]` object
  ## — into a Mezze seq of Foreigns in ONE crossing (JS `Array.from(obj)`). The
  ## cursor stays inside the runtime, so no mutable iterator reaches pure code.
  to_seq = { it } ->
    perform Runtime in Polyglot.to_seq { on = it },
  ## Bulk-drain a NUMERIC array/iterable → Mezze `[Int]` / `[Float]` in ONE crossing
  ## (the element loop AND coercion stay host-side). THE bulk path for numeric data —
  ## prefer over a per-element `index{}` + `int{}` loop (one crossing per element).
  to_ints   = { it } -> perform Runtime in Polyglot.to_int_seq   { on = it },
  to_floats = { it } -> perform Runtime in Polyglot.to_float_seq { on = it },
  ## Bulk-drain a STRING / BOOLEAN array → Mezze `[Str]` / `[Bool]` in ONE crossing.
  to_strs   = { it } -> perform Runtime in Polyglot.to_str_seq   { on = it },
  to_bools  = { it } -> perform Runtime in Polyglot.to_bool_seq  { on = it },

  ## ---- value coercions (out) ----

  ## Coerce a numeric Foreign to Int.
  int       = { it } -> perform Runtime in Polyglot.as_int    { on = it },
  ## Coerce a numeric Foreign to Float.
  float     = { it } -> perform Runtime in Polyglot.as_float  { on = it },
  ## Coerce a string Foreign to Str.
  str       = { it } -> perform Runtime in Polyglot.as_str    { on = it },
  ## Coerce a boolean Foreign to Bool.
  bool      = { it } -> perform Runtime in Polyglot.as_bool   { on = it },
  ## True iff this Foreign is JS `null` or `undefined`.
  is_null   = { it } -> perform Runtime in Polyglot.is_null   { on = it },
  ## The underlying guest type name (`typeof` / constructor name).
  type_name = { it } -> perform Runtime in Polyglot.type_name { on = it },
  ## Presence/liveness probe: `Ok {}` if the foreign is live, `Err` if it carries
  ## an error (e.g. an absent hash key read back as an errored foreign). Backs a
  ## codec's missing-field / absent-payload check.
  check     = { it } -> perform Runtime in Polyglot.check { on = it },
}

## Constructors — lift a Mezze primitive into a JsForeign so it can be passed as
## an argument to `.method{}` / `.call{}` / `.index{}`. Each mints a foreign
## through the `Polyglot` effect with the guest id `"js"` baked in here — a caller
## writes `from_int { val = 5 }`, never a `lang` string. For containers and
## records, prefer the codec (`x.to_js {}`).
pub let from_int:   { val: Int   } -> JsForeign <*> = { val } ->
  perform Runtime in Polyglot.box_int   { val = val, lang = "js" }
pub let from_float: { val: Float } -> JsForeign <*> = { val } ->
  perform Runtime in Polyglot.box_float { val = val, lang = "js" }
pub let from_str:   { val: Str   } -> JsForeign <*> = { val } ->
  perform Runtime in Polyglot.box_str   { val = val, lang = "js" }
pub let from_bool:  { val: Bool  } -> JsForeign <*> = { val } ->
  perform Runtime in Polyglot.box_bool  { val = val, lang = "js" }
pub let null_val:   {}            -> JsForeign <*> = {} ->
  perform Runtime in Polyglot.box_null  { lang = "js" }

## Build a JavaScript-visible array from already-wrapped Foreign elements — an
## interop VIEW over the elements, not a copy. Backs a codec's `encode_sequence`.
pub let js_list: { elems: [JsForeign] } -> JsForeign <*> = { elems } ->
  perform Runtime in Polyglot.box_list { elems = elems, lang = "js" }

## Bulk numeric WRITE: box a whole `[Int]` / `[Float]` into a JS array in ONE
## crossing — no per-element `from_int`. Companion to `js_list` for numeric data.
pub let js_ints:   { vals: [Int] }   -> JsForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_int_seq   { vals = vals, lang = "js" }
pub let js_floats: { vals: [Float] } -> JsForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_float_seq { vals = vals, lang = "js" }
pub let js_strs:   { vals: [Str] }   -> JsForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_str_seq   { vals = vals, lang = "js" }
pub let js_bools:  { vals: [Bool] }  -> JsForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_bool_seq  { vals = vals, lang = "js" }

## Build a JavaScript-visible mapping from parallel key and value sequences.
## Companion to `js_list`, backing a codec's `encode_mapping` / `encode_record`.
## Keys keep the order they were given in.
pub let js_dict: { keys: [JsForeign], vals: [JsForeign] } -> JsForeign <*> = { keys, vals } ->
  perform Runtime in Polyglot.box_dict { keys = keys, vals = vals, lang = "js" }

## A Mezze function as a JavaScript callable. JS functions are POSITIONAL and
## VARIADIC, so the natural form is `js_fn`: whatever JS passes arrives as one
## `args` list of `JsForeign` (decode with `.int{}` / `.str{}`). `js_fn1` / `js_fn2`
## fix the arity for the everyday callback shapes — `arr.map(f)`, `promise.then(f)`,
## `reduce(f)` — and JS calling with the wrong count is JS's arity error, thrown to
## JS. The function's row is EMPTY on purpose: JS calls it OUTSIDE every `perform`
## (GraalJS runs on the thread that entered it, callbacks included), so it may do
## nothing that needs a handler — completing a promise is the model use.
##
## GraalJS has no event loop of its own: a `then` callback is a JOB that runs when
## control returns to JS with an empty stack, i.e. at the end of the Mezze call that
## resolved the promise, or on the next call into JS. A reactor built on JS promises
## therefore pumps by calling into JS; it never needs a thread.
pub let js_fn:  { f: { args: [JsForeign] } -> 'r } -> JsForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn  { f = f, lang = "js" }
pub let js_fn1: { f: { x: JsForeign } -> 'r } -> JsForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn1 { f = f, lang = "js" }
pub let js_fn2: { f: { a: JsForeign, b: JsForeign } -> 'r } -> JsForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn2 { f = f, lang = "js" }
